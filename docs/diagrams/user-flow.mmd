flowchart TD
    Start(["Visitor"]) --> Land["Landing page"]
    Land --> Signed{"Signed in?"}
    Signed -- no --> Auth["Sign in / Sign up<br/>email or Google / GitHub"]
    Auth -- forgot --> Forgot["Forgot password"] --> Email["Email link"] --> Reset["Reset password"] --> Home
    Auth --> Home
    Signed -- yes --> Home["Home dashboard"]
    Home --> WS["Workspaces"] --> NB["Notebook"] --> Note["Note editor"]
    Home -- "New note" --> Note
    Home -- "Ctrl+K" --> Palette["Command palette"]
    Palette --> Note
    Note --> Graph["Graph + shortest path"]
    Note --> Cards["Flashcards"] --> Review["Review"]
    Home -- "Review N cards" --> Review
    Note -- "delete" --> Trash["Trash"]
    Home --> Tags["Tags"]
    Home --> Coll["Collections"]
    Home --> Act["Activity"]
    Home --> Prof["Profile<br/>password, export, delete"]

    classDef web fill:#2E1F7A,stroke:#A5B4FC,color:#EEF2FF,stroke-width:1.5px
    classDef api fill:#0B4A5C,stroke:#22D3EE,color:#ECFEFF,stroke-width:1.5px
    classDef data fill:#0B4A38,stroke:#34D399,color:#ECFDF5,stroke-width:1.5px
    classDef ext fill:#5A3A08,stroke:#FBBF24,color:#FFFBEB,stroke-width:1.5px
    classDef actor fill:#5B1F3F,stroke:#F472B6,color:#FDF2F8,stroke-width:1.5px
    classDef good fill:#14532D,stroke:#4ADE80,color:#F0FDF4,stroke-width:1.5px
    classDef bad fill:#5B1A25,stroke:#FB7185,color:#FFF1F2,stroke-width:1.5px
    linkStyle default stroke:#8B9BC4,stroke-width:1.6px
    class Start,Land actor
    class Signed ext
    class Auth,Forgot,Email,Reset ext
    class Home web
    class WS,NB,Note,Palette,Tags,Coll,Act,Prof web
    class Graph,Cards,Review api
    class Trash bad
