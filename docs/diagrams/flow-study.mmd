flowchart LR
    A["Note"] --> B["Add flashcard<br/>question + answer"]
    B --> C["Card due today"]
    C --> D["Review screen"]
    D --> E["Show answer"]
    E --> F{"How well?"}
    F -- Again --> G["Interval resets"]
    F -- Hard/Good/Easy --> H["Interval grows<br/>ease adjusts"]
    G --> I["Next card"]
    H --> I
    I --> J{"More due?"}
    J -- yes --> D
    J -- no --> K["Done for today"]

    classDef web fill:#2E1F7A,stroke:#A5B4FC,color:#EEF2FF,stroke-width:1.5px
    classDef api fill:#0B4A5C,stroke:#22D3EE,color:#ECFEFF,stroke-width:1.5px
    classDef data fill:#0B4A38,stroke:#34D399,color:#ECFDF5,stroke-width:1.5px
    classDef ext fill:#5A3A08,stroke:#FBBF24,color:#FFFBEB,stroke-width:1.5px
    classDef actor fill:#5B1F3F,stroke:#F472B6,color:#FDF2F8,stroke-width:1.5px
    classDef good fill:#14532D,stroke:#4ADE80,color:#F0FDF4,stroke-width:1.5px
    linkStyle default stroke:#8B9BC4,stroke-width:1.6px
    class A,B web
    class C,D,E,F,J ext
    class G,H,I api
    class K good
