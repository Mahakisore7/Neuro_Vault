flowchart TD
    A([Note saved with new content]) --> B["Extract [[titles]] from text<br/>at most 200, normalised whitespace"]
    B --> C["Resolve titles to the author's live notes<br/>DISTINCT ON lower(title), newest first"]
    C --> D{"Any wiki links<br/>no longer in text?"}
    D -- yes --> E["DELETE those rows<br/>WHERE origin = 'wiki'"]
    D -- no --> F
    E --> F{"Resolved targets<br/>without any link yet?"}
    F -- yes --> G["INSERT … SELECT unnest(ids)<br/>origin = 'wiki', type relates_to"]
    F -- no --> H
    G --> H["Return unresolved titles<br/>to the editor"]
    H --> I([Editor shows missing titles with a dashed underline])

    classDef web fill:#2E1F7A,stroke:#A5B4FC,color:#EEF2FF,stroke-width:1.5px
    classDef api fill:#0B4A5C,stroke:#22D3EE,color:#ECFEFF,stroke-width:1.5px
    classDef data fill:#0B4A38,stroke:#34D399,color:#ECFDF5,stroke-width:1.5px
    classDef ext fill:#5A3A08,stroke:#FBBF24,color:#FFFBEB,stroke-width:1.5px
    classDef actor fill:#5B1F3F,stroke:#F472B6,color:#FDF2F8,stroke-width:1.5px
    classDef good fill:#14532D,stroke:#4ADE80,color:#F0FDF4,stroke-width:1.5px
    linkStyle default stroke:#8B9BC4,stroke-width:1.6px
    classDef bad2 fill:#5B1A25,stroke:#FB7185,color:#FFF1F2,stroke-width:1.5px
    class A,I good
    class B,C,H api
    class D,F ext
    class E bad2
    class G data
