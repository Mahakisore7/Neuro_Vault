# NEXT_PUBLIC_* variables are compiled into the JavaScript bundle and visible
# to anyone who opens DevTools. Only the anon key belongs here — never the
# service_role key. See docs/adr/0014-direct-supabase-dev-solo.md.

NEXT_PUBLIC_SUPABASE_URL=https://yourproject.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
NEXT_PUBLIC_API_URL=http://localhost:8000
