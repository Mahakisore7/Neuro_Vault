# ─── Database ─────────────────────────────────────────────────────────────────
# Two URLs, same database, different drivers.
#   DATABASE_URL      → the application (async, asyncpg)
#   DATABASE_URL_SYNC → Alembic and psql (plain — psql cannot parse "+asyncpg")
DATABASE_URL=postgresql+asyncpg://neurovault:neurovault@localhost:5432/neurovault
DATABASE_URL_SYNC=postgresql://neurovault:neurovault@localhost:5432/neurovault

# ─── Auth ──────────────────────────────────────────────────────────────────────
# Any string >= 32 characters for local dev. scripts/make_test_token.py signs
# with this same value, so tokens it mints verify correctly against this
# backend. When a real Supabase project exists, replace with its JWT secret
# (Settings → API → JWT Settings) and nothing else in the backend changes.
SUPABASE_JWT_SECRET=local-development-secret-change-me-32chars

# ─── Application ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
ALLOWED_ORIGINS=http://localhost:3000
